{
  "name": "gemledger-26",
  "version": "2.0.1",
  "description": "GemLedger-26 Mobile — Local-First 多幣別 AI 智慧記帳系統 (React Native + Expo + SQLite + Gemini 3.5 AI)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test tests/ledger.test.ts",
    "ver": "node scripts/version.mjs show",
    "ver:patch": "node scripts/version.mjs patch",
    "ver:minor": "node scripts/version.mjs minor",
    "ver:major": "node scripts/version.mjs major",
    "ver:code": "node scripts/version.mjs code",
    "build:apk": "node scripts/build-apk.mjs",
    "release:apk": "npm run ver:patch && npm run build:apk"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-router",
    "expo-sqlite",
    "gemini-ai",
    "gemini-3.5-flash-lite",
    "bookkeeping",
    "multi-currency"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@expo/metro-runtime": "~4.0.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.2",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.0",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.12",
    "expo-haptics": "~14.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-sqlite": "~15.1.0",
    "expo-status-bar": "~2.0.0",
    "lucide-react-native": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.12",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
