{
  "name": "gemledger-ai-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Serverless Gemini AI Bookkeeping Proxy for GemLedger-26 (Cloudflare Workers + Local Node)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:worker": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.2"
  }
}
